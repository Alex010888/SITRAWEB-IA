Options -Indexes

<IfModule mod_rewrite.c>
RewriteEngine On

# Si ya va a /public, no reescribir
RewriteRule ^public/ - [L]

# Si existe el archivo o directorio, servirlo
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Enviar todo a /public manteniendo URL limpia
RewriteRule ^(.*)$ public/$1 [L,QSA]
</IfModule>

