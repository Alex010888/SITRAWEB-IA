# Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=sitra_web
DB_USER=root
DB_PASS=

# JWT Configuration
JWT_SECRET=CHANGE_THIS_TO_A_RANDOM_STRING_IN_PRODUCTION
JWT_EXPIRATION=3600

# App Configuration
API_DEBUG=true
APP_URL=http://localhost/sitra_web/backend/public
# CORS: en producción definir orígenes permitidos (separados por coma)
# CORS_ALLOWED_ORIGINS=https://admin.tudominio.com,https://www.tudominio.com
# Base URL para enlaces públicos a archivos subidos (sin /uploads)
UPLOADS_BASE_URL=http://localhost/sitra_web/backend

# Media (Module 4): max file size in MB (1–50)
MEDIA_MAX_FILE_SIZE_MB=5
