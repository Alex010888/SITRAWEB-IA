# Copiar a .env en backend/deployment/ para Docker Compose
# NO subir .env con valores reales a control de versiones.

MYSQL_ROOT_PASSWORD=changeme_strong_root_password
DB_NAME=sitra_web
DB_USER=sitra_api
DB_PASS=changeme_strong_db_password
JWT_SECRET=changeme_at_least_32_characters_random_string

UPLOADS_BASE_URL=http://localhost:8080/uploads
HTTP_PORT=8080
