# ============================================
# Backend .env – PRODUCCIÓN (Module 7)
# ============================================
# Copiar a backend/.env y ajustar. Permisos recomendados: 600
# NO incluir este archivo con valores reales en el repositorio.

# Database – usar usuario con privilegios mínimos (no root)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=sitra_web
DB_USER=sitra_api
DB_PASS=REPLACE_WITH_STRONG_PASSWORD

# JWT – secreto fuerte y expiración razonable
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_CHARS_RANDOM_STRING
JWT_EXPIRATION=3600

# App – desactivar debug en producción
API_DEBUG=false
APP_URL=https://api.tudominio.com
UPLOADS_BASE_URL=https://api.tudominio.com

# CORS – orígenes permitidos separados por coma (sin espacios)
# Ejemplo: https://admin.tudominio.com,https://www.tudominio.com
CORS_ALLOWED_ORIGINS=https://admin.tudominio.com

# Media
MEDIA_MAX_FILE_SIZE_MB=5
